{
  "name": "warden-sandbox-cli",
  "version": "0.1.14",
  "description": "npm wrapper for the Warden sandbox CLI",
  "bin": {
    "warden": "bin/warden"
  },
  "files": [
    "bin/",
    "telemetry.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node telemetry.js",
    "prepack": "node -e \"const fs=require('fs'); for (const f of ['telemetry.js','bin/warden','README.md','LICENSE']) { if (!fs.existsSync(f)) { console.error('prepack: missing required file '+f); process.exit(1); } }\"",
    "test": "node --test telemetry.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sandbox",
    "mcp",
    "security",
    "cli",
    "warden"
  ],
  "license": "MIT",
  "homepage": "https://warden-six-rouge.vercel.app/",
  "bugs": {
    "url": "https://github.com/Prof-bilal/Warden/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prof-bilal/Warden.git",
    "directory": "warden-starter/warden/build/npm-wrapper"
  }
}
