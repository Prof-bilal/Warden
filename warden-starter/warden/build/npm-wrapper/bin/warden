#!/usr/bin/env node
"use strict";

const { execFileSync } = require("child_process");
const fs = require("fs");
const path = require("path");
const os = require("os");
const https = require("https");

const VERSION = require("../package.json").version;

const platformMap = { linux: "linux", darwin: "darwin", win32: "windows" };
const archMap = { x64: "amd64", arm64: "arm64" };

const platform = os.platform();
const arch = os.arch();
const osName = platformMap[platform];
const archName = archMap[arch];
const ext = platform === "win32" ? ".exe" : "";

const fileName = `warden-${osName}-${archName}${ext}`;
const cacheRoot = path.join(os.homedir(), ".cache", "warden");

function compareVersions(a, b) {
  const norm = (s) =>
    String(s)
      .replace(/^v/, "")
      .split(/[-+]/)[0]
      .split(".")
      .map((x) => parseInt(x, 10) || 0);
  const av = norm(a);
  const bv = norm(b);
  const n = Math.max(av.length, bv.length);
  for (let i = 0; i < n; i++) {
    const x = av[i] || 0;
    const y = bv[i] || 0;
    if (x !== y) return x < y ? -1 : 1;
  }
  return 0;
}

// Prefer the newest cached binary (so `warden update` sticks), falling back
// to the package-pinned version directory for a fresh install.
function resolveBinPath() {
  let bestVer = VERSION;
  let bestPath = path.join(cacheRoot, VERSION, fileName);
  try {
    const entries = fs.readdirSync(cacheRoot, { withFileTypes: true });
    for (const ent of entries) {
      if (!ent.isDirectory()) continue;
      if (!/^\d+\.\d+/.test(ent.name)) continue;
      const candidate = path.join(cacheRoot, ent.name, fileName);
      if (!fs.existsSync(candidate)) continue;
      if (compareVersions(ent.name, bestVer) >= 0) {
        bestVer = ent.name;
        bestPath = candidate;
      }
    }
  } catch {
    // cache missing — download package version below
  }
  return { version: bestVer, binPath: bestPath };
}

function download(url, dest) {
  return new Promise((resolve, reject) => {
    https
      .get(url, { timeout: 60000 }, (res) => {
        if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
          // Drain and follow redirect without holding a write stream open on dest.
          res.resume();
          download(res.headers.location, dest).then(resolve).catch(reject);
          return;
        }
        if (res.statusCode !== 200) {
          res.resume();
          reject(new Error(`HTTP ${res.statusCode} downloading ${url}`));
          return;
        }
        const file = fs.createWriteStream(dest);
        res.pipe(file);
        file.on("finish", () => {
          file.close((err) => (err ? reject(err) : resolve()));
        });
        file.on("error", (err) => {
          fs.unlink(dest, () => {});
          reject(err);
        });
      })
      .on("error", (err) => {
        fs.unlink(dest, () => {});
        reject(err);
      });
  });
}

(async () => {
  if (!osName || !archName) {
    console.error(`warden: unsupported platform "${platform}" or architecture "${arch}"`);
    process.exit(1);
  }

  let { version, binPath } = resolveBinPath();

  if (!fs.existsSync(binPath)) {
    // Fresh install: download the package-pinned release binary.
    version = VERSION;
    binPath = path.join(cacheRoot, VERSION, fileName);
    const url = `https://github.com/Prof-bilal/Warden/releases/download/v${VERSION}/${fileName}`;
    const dir = path.dirname(binPath);
    if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
    console.log(`Downloading warden v${VERSION}...`);
    try {
      await download(url, binPath);
    } catch (err) {
      console.error(`Failed to download warden: ${err.message}`);
      process.exit(1);
    }
  }

  if (platform !== "win32") fs.chmodSync(binPath, 0o755);

  // Small update notifier: if the resolved binary is older than the package,
  // or the package is older than the registry, show a one-line warning to
  // stderr (never on stdout, so `warden --version` stays script-friendly).
  // Gated on TTY/CI and WARDEN_NO_UPDATE_CHECK.
  if (!process.env.WARDEN_NO_UPDATE_CHECK && !process.env.WARDEN_NO_UPDATE_NOTIFIER) {
    const isCI = !!(process.env.CI || process.env.GITHUB_ACTIONS);
    const isTTY = !!(process.stderr.isTTY && !isCI);
    if (isTTY) {
      // Binary vs package (no network needed)
      if (compareVersions(version, VERSION) < 0) {
        const yellow = "\x1b[33m";
        const dim = "\x1b[2m";
        const reset = "\x1b[0m";
        const useColor = !process.env.NO_COLOR && process.env.TERM !== "dumb" && !process.env.WARDEN_NO_COLOR;
        let msg = `Update available: v${version} → v${VERSION}  Run "npm i -g warden-sandbox-cli@latest"`;
        if (useColor) msg = yellow + msg + reset + dim + "  (WARDEN_NO_UPDATE_CHECK=1 to silence)" + reset;
        console.error(msg);
      } else {
        // Package vs registry (async, 800ms timeout, cached)
        const cachePath = path.join(cacheRoot, "update-check.json");
        let cachedLatest = null;
        let cachedAt = 0;
        try {
          const raw = fs.readFileSync(cachePath, "utf8");
          const j = JSON.parse(raw);
          if (j.latest && /^\d+\.\d+/.test(j.latest)) {
            cachedLatest = j.latest;
            cachedAt = j.checkedAt || 0;
          }
        } catch {}
        const now = Date.now();
        const stale = !cachedLatest || now - cachedAt > 24 * 60 * 60 * 1000;
        let latest = cachedLatest;
        if (stale) {
          const fetchLatest = () =>
            new Promise((resolve) => {
              const req = https.get(
                "https://registry.npmjs.org/warden-sandbox-cli/latest",
                { timeout: 800 },
                (res) => {
                  if (res.statusCode !== 200) {
                    res.resume();
                    resolve(null);
                    return;
                  }
                  let data = "";
                  res.on("data", (c) => (data += c));
                  res.on("end", () => {
                    try {
                      const j = JSON.parse(data);
                      if (j.version && /^\d+\.\d+/.test(j.version)) resolve(j.version);
                      else resolve(null);
                    } catch {
                      resolve(null);
                    }
                  });
                }
              );
              req.on("error", () => resolve(null));
              req.on("timeout", () => {
                req.destroy();
                resolve(null);
              });
            });
          try {
            const fetched = await Promise.race([
              fetchLatest(),
              new Promise((r) => setTimeout(() => r(null), 900)),
            ]);
            if (fetched) {
              latest = fetched;
              try {
                fs.mkdirSync(path.dirname(cachePath), { recursive: true });
                fs.writeFileSync(cachePath, JSON.stringify({ latest, checkedAt: now }), { mode: 0o600 });
              } catch {}
            }
          } catch {}
        }
        if (latest && compareVersions(VERSION, latest) < 0) {
          const yellow = "\x1b[33m";
          const dim = "\x1b[2m";
          const reset = "\x1b[0m";
          const useColor = !process.env.NO_COLOR && process.env.TERM !== "dumb" && !process.env.WARDEN_NO_COLOR;
          let msg = `Update available: v${VERSION} → v${latest}  Run "npm i -g warden-sandbox-cli@latest" or "warden update"`;
          if (useColor) msg = yellow + msg + reset + dim + "  (WARDEN_NO_UPDATE_CHECK=1 to silence)" + reset;
          console.error(msg);
        }
      }
    }
  }

  const args = process.argv.slice(2);
  try {
    execFileSync(binPath, args, { stdio: "inherit" });
  } catch (err) {
    process.exit(err.status || 1);
  }
})();
