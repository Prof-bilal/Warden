# Fixture intent: the allowlist grants one host:port pair, not the whole host.
# A request to the same hostname on another port must be denied.
filesystem:
  read:
    - "{{ .ProbeDir }}"
  write:
    - "{{ .OutDir }}"
network:
  allow:
{{- range .Allow }}
    - "{{ . }}"
{{- end }}
env:
  allow:
    - "PATH"
limits:
  timeout_s: {{ .Timeout }}
